// Prisma 7 configuration only, at this stage. The User / Movie / Genre models
// (and the migration that creates them) land in the next phase, alongside
// authentication and movie CRUD.
//
// Prisma 7 requires a driver adapter (see prisma.config.ts and the future
// src/lib/prisma.ts) and generates the client into a real, gitignored folder
// rather than into node_modules - see the `output` path below.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
