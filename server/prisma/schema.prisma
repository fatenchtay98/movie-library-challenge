generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Movie {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  releaseYear     Int
  director        String
  durationMinutes Int
  rating          Float
  posterUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  genres MovieGenre[]
}

model Genre {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  movies MovieGenre[]
}

model MovieGenre {
  movieId String @db.Uuid
  genreId String @db.Uuid

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  // Restrict, not Cascade: genres are static reference data, and silently
  // stripping classification off movies because a genre row was deleted
  // is worse than the delete just failing. We don't expose genre deletion
  // via the API anyway, so this only matters as a safety net.
  genre   Genre @relation(fields: [genreId], references: [id], onDelete: Restrict)

  @@id([movieId, genreId])
  @@index([genreId])
}
