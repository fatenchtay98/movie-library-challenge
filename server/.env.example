# Copy to .env for local (non-Docker) development.
# When running via docker-compose, these are supplied by the top-level .env instead.

NODE_ENV=development
PORT=4000

# Local dev (Postgres running via `docker compose up postgres`, mapped to host):
DATABASE_URL="postgresql://movielib:movielib@localhost:5432/movielib?schema=public"

# Origin allowed to call this API with credentials (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# --- Auth (JWT signed and stored in an httpOnly cookie) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Cookies must be `secure` (HTTPS-only) outside local dev.
COOKIE_SECURE=false

# --- TMDB (optional — only needed to re-run scripts/fetchTmdbMovies.ts,
# the one-time script that generated prisma/movies.json. Never required to
# run, build, or seed the app itself. Get a free key at
# themoviedb.org -> account settings -> API.) ---
TMDB_API_KEY=
