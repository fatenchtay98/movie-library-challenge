# Copy to .env for local (non-Docker) development.
# When running via docker-compose, these are supplied by the top-level .env instead.

NODE_ENV=development
PORT=4000

# Local dev (Postgres running via `docker compose up postgres`, mapped to host):
DATABASE_URL="postgresql://movielib:movielib@localhost:5432/movielib?schema=public"

# Origin allowed to call this API with credentials (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# --- Auth (wired in a later phase, but the shape is settled now) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
# Cookies must be `secure` (HTTPS-only) outside local dev.
COOKIE_SECURE=false
