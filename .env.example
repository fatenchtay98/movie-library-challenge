# Copy to .env at the repo root before running `docker compose up`.
# This is the ONLY .env file docker-compose reads from; server/.env and
# client/.env (also .env.example there) are for running each app outside
# Docker and are not used by the compose stack.

# --- Postgres ---
POSTGRES_USER=movielib
POSTGRES_PASSWORD=movielib
POSTGRES_DB=movielib
POSTGRES_PORT=5432

# --- Host ports exposed by the compose stack ---
SERVER_PORT=4000
CLIENT_PORT=3000

# --- Server runtime config (auth wiring lands in a later phase) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
COOKIE_SECURE=false
